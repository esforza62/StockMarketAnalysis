// This source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//@version=5
// SMC Regime Classifier
//
// Faithful port of smc_regime/regime.py's classify_regime() and the
// indicators it depends on (smc_regime/indicators.py). Keep this file in
// sync by hand if the Python thresholds or formulas change -- there is no
// automatic sync between the two.
//
// A bar is:
//   trending  if Efficiency Ratio or ADX clears its threshold
//   parabolic if it's trending AND price is stretched far from its EMA
//             (in ATR units) AND volatility (ATR%) is itself accelerating
//   choppy    otherwise
//
// Direction (up/down/flat) comes from the sign of a rolling OLS slope of
// price over the same window as the Efficiency Ratio; choppy bars have no
// direction ("n/a"), matching the Python output.
//
// Intentionally NOT ported: curvature_r2_gain. In regime.py it's computed
// as a diagnostic column but is explicitly excluded from the parabolic
// gate (see the comment on RegimeThresholds.curvature_window) -- at
// realistic bar sizes and a 14-bar window it doesn't reliably discriminate
// parabolic moves from ordinary ones, so it isn't part of the decision
// this script needs to reproduce.
indicator("SMC Regime Classifier", shorttitle = "SMC Regime", overlay = true)

// ---------------------------------------------------------------------
// Inputs -- mirror smc_regime.regime.RegimeThresholds' defaults exactly.
// Override on-chart the same way RegimeThresholds can be overridden in
// Python.
// ---------------------------------------------------------------------
grpTrend = "Trend gate (Efficiency Ratio / ADX)"
erWindow    = input.int(14, "ER window", group = grpTrend, minval = 2)
erTrendMin  = input.float(0.30, "ER trend threshold", group = grpTrend, minval = 0.0, maxval = 1.0, step = 0.01)
adxWindow   = input.int(14, "ADX window", group = grpTrend, minval = 2)
adxTrendMin = input.float(20.0, "ADX trend threshold", group = grpTrend, minval = 0.0)

grpPara = "Parabolic gate"
atrWindow    = input.int(14, "ATR window", group = grpPara, minval = 2)
atrRocWindow = input.int(5, "ATR% ROC window (bars)", group = grpPara, minval = 1)
atrRocMin    = input.float(0.05, "ATR% ROC threshold (0.05 = +5%)", group = grpPara, step = 0.01)
emaWindow    = input.int(20, "EMA window", group = grpPara, minval = 2)
extMin       = input.float(3.0, "Extension threshold (ATR units)", group = grpPara, step = 0.1)

grpDisp = "Display"
showBg      = input.bool(true, "Shade background by regime", group = grpDisp)
bgOpacity   = input.int(88, "Background opacity", group = grpDisp, minval = 50, maxval = 95)
showTable   = input.bool(true, "Show stats table", group = grpDisp)
tablePosIn  = input.string("Top Right", "Table position", group = grpDisp, options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"])
tableSizeIn = input.string("Small", "Table text size", group = grpDisp, options = ["Tiny", "Small", "Normal", "Large", "Huge", "Auto"])
showMarks   = input.bool(true, "Mark regime/direction changes", group = grpDisp)

f_tablePosition(p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

f_tableSize(s) =>
    switch s
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        "Huge"   => size.huge
        "Auto"   => size.auto
        => size.small

tablePosition = f_tablePosition(tablePosIn)
tableSize     = f_tableSize(tableSizeIn)

// ---------------------------------------------------------------------
// True range / ATR / ATR% -- Wilder smoothing (ewm(alpha=1/window,
// adjust=False) in pandas == ta.rma in Pine).
// ---------------------------------------------------------------------
trueRange = ta.tr(true)
atrVal    = ta.rma(trueRange, atrWindow)
atrPct    = atrVal / close * 100

// ---------------------------------------------------------------------
// ADX / DI -- classic Wilder DMI, same construction as indicators.adx().
// ---------------------------------------------------------------------
[diPlus, diMinus, adxVal] = ta.dmi(adxWindow, adxWindow)

// ---------------------------------------------------------------------
// Kaufman Efficiency Ratio: net move / total path length over the window,
// clipped to [0, 1]. Matches indicators.efficiency_ratio().
// ---------------------------------------------------------------------
netChange       = math.abs(close - close[erWindow])
pathLength      = math.sum(math.abs(close - close[1]), erWindow)
efficiencyRatio = pathLength != 0 ? math.min(math.max(netChange / pathLength, 0.0), 1.0) : na

// ---------------------------------------------------------------------
// Signed distance of close from its EMA, in ATR units. Matches
// indicators.ema_extension_atr_units().
// ---------------------------------------------------------------------
emaVal          = ta.ema(close, emaWindow)
emaExtensionAtr = atrVal != 0 ? (close - emaVal) / atrVal : na

// ---------------------------------------------------------------------
// ATR% rate of change over atrRocWindow bars (fractional, matches
// pandas' pct_change()). Flags volatility that is itself accelerating.
// ---------------------------------------------------------------------
atrPctPrev = atrPct[atrRocWindow]
atrPctRoc  = (not na(atrPctPrev) and atrPctPrev != 0) ? (atrPct - atrPctPrev) / atrPctPrev : na

// ---------------------------------------------------------------------
// Rolling OLS slope of close vs. bar position over erWindow bars (same
// window used for direction in regime.py). x = 0..window-1 chronologically
// (oldest to newest), matching np.arange(window) against a raw rolling
// window in pandas.
// ---------------------------------------------------------------------
f_slope(src, len) =>
    xSum = 0.0
    ySum = 0.0
    xySum = 0.0
    xxSum = 0.0
    for i = 0 to len - 1
        x = float(i)
        y = src[len - 1 - i]
        xSum += x
        ySum += y
        xySum += x * y
        xxSum += x * x
    n = float(len)
    denom = n * xxSum - xSum * xSum
    denom != 0 ? (n * xySum - xSum * ySum) / denom : na

slopeVal = f_slope(close, erWindow)

// ---------------------------------------------------------------------
// Classification -- mirrors classify_regime() exactly.
// Note: comparisons against `na` evaluate to false in Pine (unlike NaN
// propagation in pandas), so bars before enough history has accumulated
// default to "choppy" rather than being left unlabeled. Irrelevant once a
// chart has its normal amount of history loaded.
// ---------------------------------------------------------------------
isTrending  = (efficiencyRatio >= erTrendMin) or (adxVal >= adxTrendMin)
isParabolic = isTrending and (math.abs(emaExtensionAtr) >= extMin) and (atrPctRoc >= atrRocMin)

regime    = isParabolic ? "parabolic" : isTrending ? "trending" : "choppy"
direction = regime == "choppy" ? "n/a" : (slopeVal > 0 ? "up" : slopeVal < 0 ? "down" : "flat")

// ---------------------------------------------------------------------
// Display -- colors match the Regime Desk dashboard's regime palette.
// ---------------------------------------------------------------------
colChoppy    = color.new(#97A7B6, 0)
colTrending  = color.new(#5B9FE0, 0)
colParabolic = color.new(#E2933F, 0)
colTableBg    = color.new(#0E1620, 15)
colTableLabel = color.new(#8A9AAA, 0)
colTableValue = color.new(#E7ECF1, 0)

curColor = regime == "parabolic" ? colParabolic : regime == "trending" ? colTrending : colChoppy
dirSuffix = direction == "up" ? " (up)" : direction == "down" ? " (down)" : direction == "flat" ? " (flat)" : ""
dirArrow = direction == "up" ? " ↑" : direction == "down" ? " ↓" : direction == "flat" ? " →" : ""

bgcolor(showBg ? color.new(curColor, bgOpacity) : na)

regimeChanged = bar_index > 0 and (regime != regime[1] or direction != direction[1])
plotchar(showMarks and regimeChanged ? low : na, "Regime/direction change", "•", location.belowbar, color = curColor, size = size.tiny)

var table statsTable = table.new(tablePosition, 2, 7, border_width = 1, bgcolor = colTableBg)
if showTable and barstate.islast
    table.cell(statsTable, 0, 0, "Regime", text_color = colTableLabel, text_halign = text.align_left, text_size = tableSize)
    table.cell(statsTable, 1, 0, str.upper(regime) + dirArrow, text_color = curColor, text_halign = text.align_right, text_size = tableSize)
    table.cell(statsTable, 0, 1, "ER", text_color = colTableLabel, text_halign = text.align_left, text_size = tableSize)
    table.cell(statsTable, 1, 1, na(efficiencyRatio) ? "n/a" : str.tostring(efficiencyRatio, "#.###"), text_color = colTableValue, text_halign = text.align_right, text_size = tableSize)
    table.cell(statsTable, 0, 2, "ADX", text_color = colTableLabel, text_halign = text.align_left, text_size = tableSize)
    table.cell(statsTable, 1, 2, na(adxVal) ? "n/a" : str.tostring(adxVal, "#.##"), text_color = colTableValue, text_halign = text.align_right, text_size = tableSize)
    table.cell(statsTable, 0, 3, "ATR%", text_color = colTableLabel, text_halign = text.align_left, text_size = tableSize)
    table.cell(statsTable, 1, 3, na(atrPct) ? "n/a" : str.tostring(atrPct, "#.##"), text_color = colTableValue, text_halign = text.align_right, text_size = tableSize)
    table.cell(statsTable, 0, 4, "ATR% ROC", text_color = colTableLabel, text_halign = text.align_left, text_size = tableSize)
    table.cell(statsTable, 1, 4, na(atrPctRoc) ? "n/a" : str.tostring(atrPctRoc * 100, "#.#") + "%", text_color = colTableValue, text_halign = text.align_right, text_size = tableSize)
    table.cell(statsTable, 0, 5, "Ext (ATR)", text_color = colTableLabel, text_halign = text.align_left, text_size = tableSize)
    table.cell(statsTable, 1, 5, na(emaExtensionAtr) ? "n/a" : str.tostring(emaExtensionAtr, "#.##"), text_color = colTableValue, text_halign = text.align_right, text_size = tableSize)
    table.cell(statsTable, 0, 6, "Slope", text_color = colTableLabel, text_halign = text.align_left, text_size = tableSize)
    table.cell(statsTable, 1, 6, na(slopeVal) ? "n/a" : str.tostring(slopeVal, "#.###"), text_color = colTableValue, text_halign = text.align_right, text_size = tableSize)

// ---------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------
if regimeChanged and barstate.isconfirmed
    alert("SMC Regime: " + syminfo.ticker + " (" + timeframe.period + ") -> " + str.upper(regime) + dirSuffix, alert.freq_once_per_bar_close)

alertcondition(regime == "parabolic" and direction == "up",   title = "Parabolic up",   message = "{{ticker}} turned parabolic (up) on {{interval}}")
alertcondition(regime == "parabolic" and direction == "down", title = "Parabolic down", message = "{{ticker}} turned parabolic (down) on {{interval}}")
alertcondition(regimeChanged, title = "Regime or direction changed", message = "{{ticker}} SMC regime changed on {{interval}}")
