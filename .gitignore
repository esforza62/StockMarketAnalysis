__pycache__/
*.pyc
.venv/

# Rewritten in full every night, doesn't diff well as a git blob, and
# would grow repo history by ~one full copy per day forever. Published
# as a release asset instead -- see smc_regime/fetch_db.py.
backtest_logs/smc_regime.db

# Cached price bars from smc_regime.grade_backfill -- re-fetchable, and
# one full daily history per tracked ticker.
.cache/

# Built dashboard pages. The TEMPLATES in smc_regime/dashboards/ are tracked;
# a built page is ~800KB of baked database snapshot and is not. Build one with
# python -m smc_regime.build_dashboard <name> --out <file>.
/setup_grades.html
/regime_desk.html

# Vendor bars cached from the TradingView MCP for local strategy iteration.
# Not a data source -- see smc_regime/tv_bars.py. Different vendor from the
# nightly's Tiingo feed, so these must never be committed or compared with
# anything on the desk.
/backtest_logs/tv_bars/
